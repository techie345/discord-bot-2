{
  "name": "discord-ollama-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "build": "tsc --noEmit false",
    "start": "node dist/index.js",
    "dev": "nodemon --watch .env --watch src --ext ts,js,json --exec \"tsx src/index.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "latest",
    "dotenv": "latest",
    "ollama": "latest",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "nodemon": "^3.1.14",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
