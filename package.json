{
  "name": "discord-ollama-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "build": "tsc --noEmit false",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "latest",
    "dotenv": "latest",
    "ollama": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
